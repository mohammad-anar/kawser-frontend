# ========================================================
# Frontend Environment Variables (.env)
# ========================================================

# Backend API Base URL (Change to your live backend domain in production)
NEXT_PUBLIC_API_URL=https://api.carezonebd.site/api

# WebSocket Server URL (Change to your live backend domain in production)
NEXT_PUBLIC_SOCKET_URL=https://api.carezonebd.site

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=1402967271819010

# Optional: Meta Test Event Code (from Events Manager -> Test Events tab)
NEXT_PUBLIC_META_TEST_EVENT_CODE=

# Port for frontend container (default: 3000)
PORT=3000
